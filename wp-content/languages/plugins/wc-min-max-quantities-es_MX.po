#: includes/admin/class-metabox.php:38
msgid "Exclude this product from global minimum/maximum order quantity/value rules."
msgstr "Excluya este producto de las reglas de cantidad / valor de pedido mínimo / máximo global."

#: includes/admin/class-metabox.php:35
msgid "Ignore Global MinMax Rules"
msgstr "Ignorar las reglas globales de MinMax"

#: includes/admin/class-metabox.php:29
msgid "Enter a quantity to prevent  user from buying this product if they have more than the allowed quantity in their cart."
msgstr "Ingrese una cantidad para evitar que el usuario compre este producto, si tiene más de la cantidad permitida en su carrito."

#: includes/admin/class-metabox.php:26
msgid "Product Max Quantity"
msgstr "Cantidad máxima del producto"

#: includes/admin/class-metabox.php:19
msgid "Enter a quantity to prevent  user from buying this product if they have fewer than the allowed quantity in their cart."
msgstr "Ingrese una cantidad para evitar que el usuario compre este producto, si tiene menos de la cantidad permitida en su carrito."

#: includes/admin/class-metabox.php:14
msgid "Product Min Quantity"
msgstr "Cantidad mínima de producto"