# Ignore everything in the root folder
/*

# But do not ignore these specific root files
!.gitignore
!README.md

# Allow the wp-content directory structure
!wp-content/

# Ignore everything inside wp-content EXCEPT your custom folders
wp-content/*
!wp-content/themes/
!wp-content/plugins/

# Ignore default WordPress themes/plugins if you don't edit them
wp-content/themes/twentytwenty*
wp-content/plugins/akismet/
wp-content/plugins/hello.php

# Ignore uploads, cache, and system logs completely
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
*.log
error_log
.ftpquota